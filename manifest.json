{
  "manifest_version": 3,
  "name": "ChatGPT Office Math Copy",
  "version": "1.1.0",
  "description": "Batch-copy ChatGPT text and multiple math formulas to Microsoft Word and PowerPoint using ChatGPT's native Presentation MathML.",
  "permissions": ["clipboardRead", "clipboardWrite"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content-stable.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
